{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File with Arguments",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      // "args": "${command:pickArgs}",
      "preLaunchTask": "Export ZBAR"
    },
    {
      "name": "Django Debugger",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "-l", "6"],
      "django": true,
      "justMyCode": true
    }
  ]
}
