# Generate the keys with the following command:
# sh scripts/keys.sh

# Both keys are base64 encoded
SERVER_PRIVATE_KEY=
SERVER_PUBLIC_KEY=

# Set LOCAL_DB to True if you want to use a local database (db.sqlite3)
LOCAL_DB=False

DATABASES_NAME=
DATABASES_USER=
DATABASES_PASSWORD=
DATABASES_HOST=
DATABASES_PORT=

# Set LOCAL_STORAGE to True if you want to use local storage
LOCAL_STORAGE=True

SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_BUCKET_NAME=
SUPABASE_S3_REGION_NAME=
SUPABASE_S3_ENDPOINT=
